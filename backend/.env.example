# Copy to backend/.env for local development. Never commit the real .env.
ENVIRONMENT=development
DATABASE_URL=postgresql://daleel_app:daleel_local_dev@/daleel?host=/tmp
# Long random value in production, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Free OpenRouter key: https://openrouter.ai/keys  (use AI_PROVIDER=off for template summaries only)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
CORS_ORIGINS=http://localhost:5173
